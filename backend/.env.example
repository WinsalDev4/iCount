# Copia este fichero a backend/.env y ajústalo. Nunca subas .env al repositorio.
# Se valida al arrancar (src/shared/config/app-config.ts): si algo está mal, la API no arranca.
NODE_ENV=development
PORT=3000
# Coincide con los valores por defecto de docker-compose.yml (raíz del repo)
DATABASE_URL=postgres://icount:icount@localhost:5432/icount
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Base de datos de los tests e2e (se crea sola si no existe)
TEST_DATABASE_URL=postgres://icount:icount@localhost:5432/icount_test

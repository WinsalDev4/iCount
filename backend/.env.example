# Copia este fichero a backend/.env y ajústalo. Nunca subas .env al repositorio.
# Se valida al arrancar (src/shared/config/app-config.ts): si algo está mal, la API no arranca.
NODE_ENV=development
PORT=3000
# Coincide con los valores por defecto de docker-compose.yml (raíz del repo)
DATABASE_URL=postgres://icount:icount@localhost:5432/icount
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Firma de los access tokens (ADR-0013). Genera uno propio: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=cambia-esto-por-un-secreto-aleatorio-de-al-menos-32-caracteres
# Email (Mailpit en desarrollo: docker compose up -d, web en http://localhost:8025)
SMTP_URL=smtp://localhost:1025
MAIL_FROM=iCount <no-reply@icount.local>
# Destino de los enlaces mágicos (deep link de la app)
MAGIC_LINK_URL=icount://auth/verify
# Base de datos de los tests e2e (se crea sola si no existe)
TEST_DATABASE_URL=postgres://icount:icount@localhost:5432/icount_test

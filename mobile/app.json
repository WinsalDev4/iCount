{
  "expo": {
    "name": "iCount",
    "slug": "icount",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.winsal.icount"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "dev.winsal.icount"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0C1A",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Permite que $(PRODUCT_NAME) use Face ID para desbloquear tu sesión."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Permite que $(PRODUCT_NAME) use Face ID para desbloquear tu sesión."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#8C7BFF",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": ["es", "en"],
            "android": ["es", "en"]
          }
        }
      ]
    ],
    "scheme": "icount",
    "experiments": {
      "typedRoutes": true
    },
    "backgroundColor": "#0B0C1A"
  }
}

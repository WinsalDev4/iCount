{
  "name": "@icount/contracts",
  "version": "0.1.0",
  "description": "Contratos compartidos entre la API y la app de iCount (esquemas zod + tipos inferidos)",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "oxlint --type-aware src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\""
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "typescript": "~6.0.3",
    "vitest": "^4.1.2"
  }
}

{
  "name": "@icount/finance",
  "version": "0.1.0",
  "description": "Motor financiero de iCount: cálculos puros sobre céntimos enteros, compartido por la app y la API",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "oxlint --type-aware src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\""
  },
  "devDependencies": {
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "typescript": "~6.0.3",
    "vitest": "^4.1.2"
  }
}
